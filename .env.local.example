# URL publique de l'API (utilisée par le navigateur pour les appels directs)
NEXT_PUBLIC_API_URL="http://localhost:3000"
# URL privée de l'API (utilisée par les routes proxy Next.js côté serveur)
# En production, pointer vers l'URL Render. Si absent, NEXT_PUBLIC_API_URL sert de repli.
# API_URL="https://your-backend.onrender.com"
